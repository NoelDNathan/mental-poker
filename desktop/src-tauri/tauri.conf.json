{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dog Poker Club Lab",
  "version": "0.2.1",
  "identifier": "club.dogpoker.desktop.lab",
  "build": {
    "frontendDist": "../boot"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'; style-src 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../stage/app/": "app/"
    },
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
