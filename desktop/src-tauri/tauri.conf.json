{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dog Poker Club Lab",
  "version": "0.2.0",
  "identifier": "club.dogpoker.desktop.lab",
  "build": {
    "frontendDist": "../boot"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dog Poker Club (lab)",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'none'; style-src 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../stage/app/": "app/"
    }
  }
}
